<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.9" />
    <ProjectReference Include="../AgentHQDemo.Core/AgentHQDemo.Core.csproj" />
    <ProjectReference Include="../AgentHQDemo.McpServer/AgentHQDemo.McpServer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyRetailMcpServer" AfterTargets="Build">
    <ItemGroup>
      <RetailMcpFiles Include="../AgentHQDemo.McpServer/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(RetailMcpFiles)" DestinationFiles="@(RetailMcpFiles->'$(OutDir)mcp/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
